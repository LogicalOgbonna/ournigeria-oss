{
  "name": "ingest",
  "projectType": "application",
  "sourceRoot": "apps/ingest/src",
  "targets": {
    "dev": {
      "command": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev --path /ingest --watch -- nest start --watch",
      "options": {
        "cwd": "apps/ingest"
      }
    },
    "build": {
      "command": "nest build",
      "options": {
        "cwd": "apps/ingest"
      }
    },
    "start": {
      "command": "infisical run --env prod --path /ingest --watch -- nest start",
      "options": {
        "cwd": "apps/ingest"
      }
    }
  }
}
