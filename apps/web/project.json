{
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "dev": {
      "command": "next dev",
      "options": {
        "cwd": "apps/web"
      }
    },
    "build": {
      "command": "next build",
      "options": {
        "cwd": "apps/web"
      }
    },
    "start": {
      "command": "next start",
      "options": {
        "cwd": "apps/web"
      }
    },
    "lint": {
      "command": "eslint",
      "options": {
        "cwd": "apps/web"
      }
    },
    "ingest": {
      "command": "NODE_OPTIONS='--max-old-space-size=8192' tsx --env-file=.env src/mastra/rag/ingest.ts",
      "options": {
        "cwd": "apps/web"
      }
    },
    "ingest:corruption": {
      "command": "NODE_OPTIONS='--max-old-space-size=8192' tsx --env-file=.env src/mastra/rag/ingest-corruption.ts",
      "options": {
        "cwd": "apps/web"
      }
    }
  }
}
