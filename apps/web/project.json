{
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "dev": {
      "command": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev --path /web --watch -- next dev",
      "options": {
        "cwd": "apps/web"
      }
    },
    "build": {
      "command": "next build",
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "cwd": "apps/web"
      }
    },
    "start": {
      "command": "next start",
      "options": {
        "cwd": "apps/web"
      }
    },
    "lint": {
      "command": "eslint",
      "options": {
        "cwd": "apps/web"
      }
    }
  }
}
