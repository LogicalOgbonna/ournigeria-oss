generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum MessageRole {
  user
  assistant
  system

  @@map("message_role")
}

enum ConversationStatus {
  active
  archived
  deleted

  @@map("conversation_status")
}

enum DocumentStatus {
  unprocessed
  parsing
  parsed
  indexing
  indexed
  error

  @@map("document_status")
}

enum DocumentFileType {
  pdf
  xlsx
  xls
  csv
  docx

  @@map("document_file_type")
}

// ============================================================
// Models
// ============================================================

model NigerianState {
  code            String @id @db.VarChar(30)
  name            String @unique @db.VarChar(50)
  geopoliticalZone String @map("geopolitical_zone") @db.VarChar(20)
  capital         String @db.VarChar(50)

  documents        Document[]
  budgetSummaries  BudgetSummary[]
  sourceReferences SourceReference[]

  @@map("nigerian_states")
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber String?  @unique @map("phone_number") @db.VarChar(20)
  telegramId  String?  @unique @map("telegram_id") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz()
  preferences Json     @default("{}") @db.JsonB

  conversations  Conversation[]
  queryAnalytics QueryAnalytic[]

  @@map("users")
}

model OtpVerification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber String   @map("phone_number") @db.VarChar(20)
  code        String   @db.VarChar(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz()
  attempts    Int      @default(0)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([phoneNumber, verified, expiresAt], map: "idx_otp_phone_active")
  @@map("otp_verifications")
}

model Conversation {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  title           String             @default("New Conversation") @db.VarChar(200)
  status          ConversationStatus @default(active)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  mentionedStates String[]           @default([]) @map("mentioned_states")
  mentionedYears  Int[]              @default([]) @map("mentioned_years") @db.SmallInt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, status, createdAt(sort: Desc)], map: "idx_conversations_user_active")
  @@map("conversations")
}

model Message {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId   String      @map("conversation_id") @db.Uuid
  sequenceNumber   Int         @map("sequence_number")
  role             MessageRole
  content          String      @db.Text
  richContent      Json?       @map("rich_content") @db.JsonB
  modelUsed        String?     @map("model_used") @db.VarChar(50)
  promptTokens     Int?        @map("prompt_tokens")
  completionTokens Int?        @map("completion_tokens")
  totalTokens      Int?        @map("total_tokens")
  processingTimeMs Int?        @map("processing_time_ms")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  conversation     Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceReferences SourceReference[]
  queryAnalytics   QueryAnalytic[]

  @@unique([conversationId, sequenceNumber])
  @@index([conversationId, sequenceNumber], map: "idx_messages_conversation_seq")
  @@index([createdAt(sort: Desc)], map: "idx_messages_created")
  @@map("messages")
}

model Document {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stateCode         String      @map("state_code") @db.VarChar(30)
  fiscalYear        Int         @map("fiscal_year") @db.SmallInt
  fileName          String      @map("file_name") @db.VarChar(255)
  filePath          String      @unique @map("file_path") @db.VarChar(500)
  fileType          DocumentFileType @map("file_type")
  fileSizeBytes     BigInt?     @map("file_size_bytes")
  fileHashSha256    String?     @map("file_hash_sha256") @db.VarChar(64)
  status            DocumentStatus @default(unprocessed)
  errorDetails      String?     @map("error_details") @db.Text
  parsedAt          DateTime?   @map("parsed_at") @db.Timestamptz()
  indexedAt          DateTime?   @map("indexed_at") @db.Timestamptz()
  metadata          Json        @default("{}") @db.JsonB
  pageCount         Int?        @map("page_count")
  extractedSections Json?       @map("extracted_sections") @db.JsonB
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  state            NigerianState     @relation(fields: [stateCode], references: [code])
  sourceReferences SourceReference[]
  budgetSummaries  BudgetSummary[]

  @@index([stateCode, fiscalYear], map: "idx_documents_state_year")
  @@map("documents")
}

model SourceReference {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId       String  @map("message_id") @db.Uuid
  documentId      String  @map("document_id") @db.Uuid
  pageNumber      Int?    @map("page_number")
  lineStart       Int?    @map("line_start")
  lineEnd         Int?    @map("line_end")
  sheetName       String? @map("sheet_name") @db.VarChar(100)
  sectionHeading  String? @map("section_heading") @db.VarChar(300)
  snippet         String? @db.Text
  confidenceScore Decimal? @map("confidence_score") @db.Decimal(3, 2)
  stateCode       String? @map("state_code") @db.VarChar(30)
  fiscalYear      Int?    @map("fiscal_year") @db.SmallInt
  relevanceRank   Int?    @map("relevance_rank")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  message  Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  state    NigerianState? @relation(fields: [stateCode], references: [code])

  @@index([messageId], map: "idx_source_refs_message")
  @@index([documentId], map: "idx_source_refs_document")
  @@index([stateCode, fiscalYear], map: "idx_source_refs_state_year")
  @@map("source_references")
}

model BudgetSummary {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stateCode         String   @map("state_code") @db.VarChar(30)
  fiscalYear        Int      @map("fiscal_year") @db.SmallInt
  totalBudget       BigInt   @map("total_budget")
  allocations       Json     @default("{}") @db.JsonB
  sourceDocumentId  String?  @map("source_document_id") @db.Uuid
  populationEstimate BigInt? @map("population_estimate")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  state          NigerianState @relation(fields: [stateCode], references: [code])
  sourceDocument Document?     @relation(fields: [sourceDocumentId], references: [id])

  @@unique([stateCode, fiscalYear])
  @@index([stateCode], map: "idx_budget_summaries_state")
  @@index([fiscalYear], map: "idx_budget_summaries_year")
  @@index([fiscalYear, totalBudget(sort: Desc)], map: "idx_budget_summaries_year_total")
  @@map("budget_summaries")
}

model QueryAnalytic {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  messageId     String?  @map("message_id") @db.Uuid
  queryCategory String?  @map("query_category") @db.VarChar(50)
  queriedStates String[] @default([]) @map("queried_states")
  queriedYears  Int[]    @default([]) @map("queried_years") @db.SmallInt
  queryText     String?  @map("query_text") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([queryCategory, createdAt(sort: Desc)], map: "idx_analytics_category_date")
  @@index([createdAt(sort: Desc)], map: "idx_analytics_date")
  @@map("query_analytics")
}
