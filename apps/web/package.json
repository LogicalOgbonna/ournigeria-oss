{
  "name": "@naija-budget/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "infisical run --env dev --watch -- next dev",
    "build": "infisical run --env dev -- next build",
    "start": "infisical run --env dev -- next start",
    "lint": "eslint",
    "prisma:generate": "infisical run --env dev -- prisma generate",
    "prisma:migrate": "infisical run --env dev -- prisma migrate dev",
    "prisma:studio": "infisical run --env dev -- prisma studio",
    "prisma:seed": "infisical run --env dev -- prisma db seed",
    "prisma:reset": "infisical run --env dev -- prisma migrate reset",
    "prisma:reset:force": "infisical run --env dev -- prisma migrate reset --force",
    "prisma:reset:force:with-seed": "infisical run --env dev -- sh -c 'prisma migrate reset --force && prisma db seed'",
    "prisma:reset:force:with-seed:and-migrate": "infisical run --env dev -- sh -c 'prisma migrate reset --force && prisma migrate dev && prisma db seed'"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.30",
    "@mastra/core": "^1.5.0",
    "@mastra/pg": "^1.5.0",
    "@mastra/rag": "^2.1.0",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@tavily/core": "^0.7.1",
    "ai": "^6.0.97",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.18.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "lightningcss-darwin-arm64": "^1.31.1",
    "prisma": "^7.4.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
