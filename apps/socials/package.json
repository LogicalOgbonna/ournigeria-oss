{
  "name": "@ournigeria/socials",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev --path /socials --watch -- nest start --watch",
    "build": "nest build",
    "start": "infisical run --env prod --path /socials -- node dist/main",
    "start:prod": "infisical run --env prod --path /socials -- node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "x-oauth-bootstrap": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev --path /socials -- tsx src/scripts/x-oauth-bootstrap.ts",
    "x-oauth-authorize": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev --path /socials -- tsx src/scripts/x-oauth-authorize.ts",
    "x-post-test": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev --path /socials -- tsx src/scripts/x-post-test.ts",
    "x-reply-test": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev --path /socials -- tsx src/scripts/x-reply-test.ts",
    "seed-topics": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev --path /socials -- tsx src/scripts/seed-topics.ts",
    "seed-bot-sessions": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev --path /socials -- tsx src/scripts/seed-bot-sessions.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.0",
    "ai": "^6.0.0",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@ournigeria/content": "workspace:*",
    "@ournigeria/access": "workspace:*",
    "@ournigeria/database": "workspace:*",
    "@ournigeria/tools": "workspace:*",
    "opossum": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "twitter-api-v2": "1.29.0",
    "x-client-transaction-id": "^0.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/opossum": "catalog:",
    "ts-loader": "catalog:",
    "ts-node": "catalog:",
    "tsconfig-paths": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
