{
  "manifest_version": 3,
  "name": "OurNigeria Socials — session capture",
  "version": "0.1.0",
  "description": "Capture an x.com session row (cookie, csrf, headers) for the OurNigeria socials roamer.",
  "permissions": ["cookies", "webRequest", "storage"],
  "host_permissions": [
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Capture x.com session",
    "default_popup": "popup.html"
  }
}
