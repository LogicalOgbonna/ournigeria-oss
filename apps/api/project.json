{
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "dev": {
      "command": "nest start --watch",
      "options": {
        "cwd": "apps/api"
      }
    },
    "build": {
      "command": "nest build",
      "options": {
        "cwd": "apps/api"
      }
    },
    "start": {
      "command": "nest start",
      "options": {
        "cwd": "apps/api"
      }
    },
    "prisma:generate": {
      "command": "prisma generate",
      "options": {
        "cwd": "apps/api"
      }
    }
  }
}
