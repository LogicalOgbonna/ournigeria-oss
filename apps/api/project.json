{
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "dev": {
      "command": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev --path /api --watch -- nest start --watch",
      "options": {
        "cwd": "apps/api"
      }
    },
    "build": {
      "command": "nest build",
      "options": {
        "cwd": "apps/api"
      }
    },
    "start": {
      "command": "infisical run --env prod --path /api --watch -- nest start",
      "options": {
        "cwd": "apps/api"
      }
    },
    "prisma:generate": {
      "command": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --path /api -- prisma generate",
      "options": {
        "cwd": "apps/api"
      }
    }
  }
}
