FROM alpine:3.21

# Install Docker CLI + tools
RUN apk add --no-cache docker-cli docker-cli-compose curl jq bash

# TARGETARCH (amd64/arm64) is auto-provided by BuildKit so binaries match the platform.
ARG TARGETARCH

# Infisical CLI — deploy.sh's enrichment bump runs `infisical run` inside this
# container to inject /enrichment secrets before `docker compose up`.
ARG INFISICAL_VERSION=0.43.121
RUN wget -qO /tmp/infisical.tar.gz \
      "https://github.com/Infisical/cli/releases/download/v${INFISICAL_VERSION}/cli_${INFISICAL_VERSION}_linux_${TARGETARCH}.tar.gz" && \
    tar -xzf /tmp/infisical.tar.gz -C /usr/local/bin/ infisical && \
    rm /tmp/infisical.tar.gz && \
    chmod +x /usr/local/bin/infisical && \
    infisical --version

# Install webhook from official release (Alpine package has broken HMAC validation).
ARG WEBHOOK_VERSION=2.8.2
RUN wget -qO /tmp/webhook.tar.gz \
      "https://github.com/adnanh/webhook/releases/download/${WEBHOOK_VERSION}/webhook-linux-${TARGETARCH}.tar.gz" && \
    tar -xzf /tmp/webhook.tar.gz -C /usr/local/bin/ --strip-components=1 && \
    rm /tmp/webhook.tar.gz && \
    chmod +x /usr/local/bin/webhook

ENTRYPOINT ["/usr/local/bin/webhook"]
