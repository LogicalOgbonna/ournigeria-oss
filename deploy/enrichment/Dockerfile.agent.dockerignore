# Per-Dockerfile ignore for the agent image (BuildKit uses this instead of the repo-root
# .dockerignore, which excludes **/*.md — but we must COPY SOUL.md + SKILL.md).
# Keep the context small; allow the markdown + tool files the agent image needs.
.git
**/node_modules
**/dist
**/*.log
.nx
.turbo
.claude
.devcontainer
.github
packages/db
packages/db_backup
apps/web
apps/awanaija
apps/socials
apps/videos
apps/uploads
notebooklm
design
