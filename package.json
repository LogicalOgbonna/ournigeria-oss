{
  "name": "@ournigeria/root",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "web:dev": "nx run web:dev",
    "web:build": "nx run web:build",
    "web:start": "nx run web:start",
    "web:lint": "nx run web:lint",
    "prisma:generate": "nx run database:prisma:generate",
    "prisma:migrate": "nx run database:prisma:migrate",
    "prisma:migrate:create": "nx run database:prisma:migrate:create --",
    "prisma:studio": "nx run database:prisma:studio",
    "ingest": "nx run web:ingest",
    "ingest:corruption": "nx run web:ingest:corruption",
    "api:dev": "nx run api:dev",
    "api:build": "nx run api:build",
    "api:start": "nx run api:start",
    "okf:export": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev --path /api -- npx tsx --tsconfig apps/api/tsconfig.json apps/api/src/okf/okf-export.cli.ts",
    "okf:publish": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev --path /api -- npx tsx --tsconfig apps/api/tsconfig.json apps/api/src/okf/okf-publish.cli.ts",
    "setup": "bash packages/scripts/setup/setup.sh",
    "secret:login": "bash packages/scripts/setup/secret-login.sh",
    "packages:build": "nx run-many -t build --projects=packages/*",
    "db:build": "nx run database:build",
    "ingest:dev": "nx run ingest:dev",
    "ingest:build": "nx run ingest:build",
    "ingest:start": "nx run ingest:start",
    "awanaija:dev": "nx run awanaija:dev",
    "awanaija:build": "nx run awanaija:build",
    "awanaija:start": "nx run awanaija:start",
    "videos:dev": "nx run videos:dev",
    "videos:build": "nx run videos:build",
    "videos:start": "nx run videos:dev",
    "videos:generate": "cd apps/videos && infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev -- npx tsx scripts/generate.ts",
    "videos:smoke-test": "cd apps/videos && npx tsx scripts/smoke-test.ts",
    "dashboard:dev": "nx run dashboard:dev",
    "dashboard:build": "nx run dashboard:build",
    "dashboard:start": "nx run dashboard:start",
    "socials:dev": "nx run socials:dev",
    "socials:build": "nx run socials:build",
    "socials:start": "nx run socials:start",
    "test:e2e": "nx run e2e:test",
    "test:e2e:web": "nx run e2e:test:web",
    "test:e2e:dashboard": "nx run e2e:test:dashboard",
    "test:e2e:human": "nx run e2e:test:human",
    "start": "bash packages/scripts/setup/start.sh",
    "start:detach": "bash packages/scripts/setup/start.sh -d",
    "start:list": "bash packages/scripts/setup/start.sh -l",
    "start:stop": "bash packages/scripts/setup/start.sh -k",
    "content:generate": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev -- npx tsx packages/content/generate.ts",
    "content:query": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev -- npx tsx packages/content/query.ts",
    "content:render": "npx tsx packages/content/render.ts",
    "content:engine": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev -- npx tsx packages/content/engine.ts",
    "content:batch": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --env dev -- npx tsx packages/content/batch.ts",
    "content:coverage": "npx tsx packages/content/batch.ts --coverage"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@nx/js": "21.6.10",
    "marked": "17.0.4",
    "nx": "21.6.10",
    "nx-ignore": "19.8.0",
    "portless": "0.13.0",
    "puppeteer": "24.40.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@napi-rs/canvas",
      "@prisma/engines",
      "canvas",
      "esbuild",
      "lightningcss",
      "nx",
      "prisma",
      "sharp",
      "tesseract.js",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@swc/core"
    ]
  },
  "dependencies": {
    "pptxgenjs": "4.0.1"
  },
  "license": "AGPL-3.0-only"
}
