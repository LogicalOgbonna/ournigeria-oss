/// Federal government payments. 445K rows.
model FederalSpending {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityCode       String   @map("entity_code") @db.VarChar(60)
  date             DateTime @db.Date
  paymentNo        String   @unique @map("payment_no") @db.VarChar(50)
  payerCode        String   @map("payer_code") @db.VarChar(20)
  organizationName String   @map("organization_name") @db.Text
  beneficiaryName  String   @map("beneficiary_name") @db.Text
  amount           Decimal  @db.Decimal(20, 2)
  description      String   @db.Text
  sourceUrl        String?  @map("source_url") @db.Text
