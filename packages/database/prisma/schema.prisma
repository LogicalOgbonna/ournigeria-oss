generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum MessageRole {
  user
  assistant
  system

  @@map("message_role")
}

enum ConversationStatus {
  active
  archived
  deleted

  @@map("conversation_status")
}

enum ConversationVisibility {
  private
  public

  @@map("conversation_visibility")
}

enum DocumentStatus {
  unprocessed
  parsing
  parsed
  indexing
  indexed
  error

  @@map("document_status")
}

enum DocumentFileType {
  pdf
  xlsx
  xls
  csv
  docx

  @@map("document_file_type")
}

enum NotificationType {
  incident
  announcement
  info
  warning

  @@map("notification_type")
}

enum BannerType {
  incident
  announcement
  warning

  @@map("banner_type")
}

enum FeedbackStatus {
  new
  reviewing
  resolved
  archived

  @@map("feedback_status")
}

enum FeedbackCategory {
  bug
  feature
  general
  data_issue

  @@map("feedback_category")
}

enum DonationProvider {
  PAYSTACK
  FLUTTERWAVE

  @@map("donation_provider")
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("donation_status")
}

enum BackupStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum BackupType {
  FULL
  RELATIONAL
}

// ============================================================
// Models
// ============================================================

model AdminUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz()
  createdById  String?   @map("created_by_id") @db.Uuid

  createdBy    AdminUser?  @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers AdminUser[] @relation("AdminCreatedBy")

  @@map("admin_users")
}

model GeopoliticalZone {
  code String @id @db.VarChar(20)
  name String @unique @db.VarChar(30)

  states NigerianState[]

  @@map("geopolitical_zones")
}

model NigerianState {
  code     String @id @db.VarChar(30)
  name     String @unique @db.VarChar(50)
  zoneCode String @map("zone_code") @db.VarChar(20)
  capital  String @db.VarChar(50)

  zone              GeopoliticalZone       @relation(fields: [zoneCode], references: [code])
  documents         Document[]
  sourceReferences  SourceReference[]
  lgas              NigerianLga[]
  constituencies    NigerianConstituency[]
  fiscalEntity      FiscalEntity?
  stateProfile      StateProfile?
  officialPositions OfficialPosition[]
  politicalTerms    PoliticalTerm[]
  officialElections OfficialElection[]
  corruptionCases   CorruptionCase[]
  partyChapters     PartyStateChapter[]

  @@index([zoneCode], map: "idx_states_zone")
  @@map("nigerian_states")
}

// Curated, admin-editable state-level profile. One-to-one with NigerianState.
// All fields nullable (partial curation). Seeded from data/state-profiles.json.
// TODO(state-profile): build an admin-dashboard editing UI + backfill nulled
// fields. Tracked in PROGRESS.md. No write path exists yet — read-only.
model StateProfile {
  stateCode String @id @map("state_code") @db.VarChar(30)

  // Identity & orientation
  about        String?   @db.Text
  motto        String?   @db.VarChar(120)
  dateCreated  DateTime? @map("date_created") @db.Date
  landAreaSqKm Decimal?  @map("land_area_sq_km") @db.Decimal(10, 2)
  sealImageUrl String?   @map("seal_image_url") @db.Text
  flagImageUrl String?   @map("flag_image_url") @db.Text

  // Official links & sourcing
  officialWebsiteUrl String? @map("official_website_url") @db.Text
  financeMinistryUrl String? @map("finance_ministry_url") @db.Text
  assemblyWebsiteUrl String? @map("assembly_website_url") @db.Text
  inecInfoUrl        String? @map("inec_info_url") @db.Text
  // State Independent Electoral Commission (SIEC) — the state body that runs
  // Local Government elections, distinct from the federal INEC (inecInfoUrl).
  stateElectoralCommissionUrl String? @map("state_electoral_commission_url") @db.Text

  // Contact & accountability
  contactAddress     String? @map("contact_address") @db.Text
  contactPhone       String? @map("contact_phone") @db.VarChar(60)
  contactEmail       String? @map("contact_email") @db.Text
  complaintPortalUrl String? @map("complaint_portal_url") @db.Text
  whistleblowerUrl   String? @map("whistleblower_url") @db.Text

  // Social & news
  twitterUrl   String? @map("twitter_url") @db.Text
  facebookUrl  String? @map("facebook_url") @db.Text
  instagramUrl String? @map("instagram_url") @db.Text
  youtubeUrl   String? @map("youtube_url") @db.Text
  newsUrl      String? @map("news_url") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  state NigerianState @relation(fields: [stateCode], references: [code])

  @@map("state_profiles")
}

model NigerianLga {
  code      String @id @db.VarChar(60)
  name      String @db.VarChar(100)
  stateCode String @map("state_code") @db.VarChar(30)

  state              NigerianState           @relation(fields: [stateCode], references: [code])
  fiscalEntity       FiscalEntity?
  wards              NigerianWard[]
  senatorialMappings SenatorialDistrictLga[]
  officialPositions  OfficialPosition[]
  budgetLocations    BudgetLocation[]
  officialElections  OfficialElection[]

  @@index([stateCode], map: "idx_lgas_state")
  @@map("nigerian_lgas")
}

model NigerianConstituency {
  code      String  @id @db.VarChar(80)
  name      String  @db.VarChar(200)
  type      String  @db.VarChar(20)
  stateCode String  @map("state_code") @db.VarChar(30)
  pcode     String? @db.VarChar(20)

  state             NigerianState           @relation(fields: [stateCode], references: [code])
  lgaMappings       SenatorialDistrictLga[]
  wardMappings      ConstituencyWard[]
  officialPositions OfficialPosition[]
  officialElections OfficialElection[]

  @@index([stateCode, type], map: "idx_constituencies_state_type")
  @@map("nigerian_constituencies")
}

/// Any Nigerian public official/government figure — NOT only politicians.
/// `officialType` classifies (elected/appointed/...); political data (positions,
/// party, elections) lives in optional one-to-many tables. Plan 45.
model NigerianOfficial {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @db.VarChar(200)
  slug          String?   @unique @db.VarChar(160)
  officialType  String?   @map("official_type") @db.VarChar(20)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  email         String?   @db.VarChar(255)
  phoneNumber   String?   @map("phone_number") @db.VarChar(30)
  officeAddress String?   @map("office_address") @db.Text
  twitterHandle String?   @map("twitter_handle") @db.VarChar(100)
  facebookUrl   String?   @map("facebook_url") @db.VarChar(500)
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        String?   @db.VarChar(10)
  /// Legacy freeform text — fallback when no structured OfficialEducation rows exist.
  education     String?   @db.Text
  /// Narrative summary — kept as intro/fallback alongside structured sections.
  biography     String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  completenessScore Decimal? @map("completeness_score") @db.Decimal(3, 2)

  positions OfficialPosition[]
  proposals DataProposal[]

  educationRecords  OfficialEducation[]
  careers           OfficialCareer[]
  partyAffiliations OfficialPartyAffiliation[]
  committees        OfficialCommittee[]
  sponsoredBills    OfficialSponsoredBill[]
  elections         OfficialElection[]
  assetDeclarations OfficialAssetDeclaration[]
  awards            OfficialAward[]
  publications      OfficialPublication[]
  familyMembers     OfficialFamilyMember[]
  relatedAsFamily   OfficialFamilyMember[]     @relation("FamilyRelatedOfficial")
  legalCases        OfficialLegalCase[]
  enrichmentAttempts EnrichmentAttempt[]
  partyOfficerRoles PartyOfficer[]

  @@map("nigerian_officials")
}

/// Exclusive arcs: exactly one of state_code, constituency_code, lga_code, ward_code
/// must be non-null (enforced by CHECK constraint in migration SQL).
/// No is_current column — "current" is derived via status + dates.
/// CHECK constraints for role-scope, appointment_type, status, etc. in migration SQL.
/// Views: current_positions, preferred_current_positions (see migration).
model OfficialPosition {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officialId       String    @map("official_id") @db.Uuid
  termId           String?   @map("term_id") @db.Uuid
  partyAcronym     String?   @map("party_acronym") @db.VarChar(20)
  role             String    @db.VarChar(50)
  appointmentType  String    @default("elected") @map("appointment_type") @db.VarChar(20)
  status           String    @default("active") @db.VarChar(20)
  leadershipRole   String?   @map("leadership_role") @db.VarChar(50)
  stateCode        String?   @map("state_code") @db.VarChar(30)
  constituencyCode String?   @map("constituency_code") @db.VarChar(80)
  lgaCode          String?   @map("lga_code") @db.VarChar(60)
  wardCode         String?   @map("ward_code") @db.VarChar(100)
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  endReason        String?   @map("end_reason") @db.VarChar(30)
  sourceType       String    @default("manual") @map("source_type") @db.VarChar(20)
  sourceUrl        String?   @map("source_url") @db.Text
  sourceDate       DateTime? @map("source_date") @db.Date
  confidence       String    @default("medium") @db.VarChar(10)
  lastVerifiedAt   DateTime? @map("last_verified_at") @db.Timestamptz()
  reviewedBy       String?   @map("reviewed_by") @db.VarChar(100)
  reviewStatus     String    @default("unreviewed") @map("review_status") @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  official     NigerianOfficial      @relation(fields: [officialId], references: [id], onDelete: Cascade)
  term         PoliticalTerm?        @relation(fields: [termId], references: [id])
  party        PoliticalParty?       @relation(fields: [partyAcronym], references: [acronym])
  state        NigerianState?        @relation(fields: [stateCode], references: [code])
  constituency NigerianConstituency? @relation(fields: [constituencyCode], references: [code])
  lga          NigerianLga?          @relation(fields: [lgaCode], references: [code])
  ward         NigerianWard?         @relation(fields: [wardCode], references: [code])
  proposals    DataProposal[]
  committees   OfficialCommittee[]
  electionsWon OfficialElection[]

  @@index([termId], map: "idx_positions_term")
  @@index([stateCode, status], map: "idx_positions_state_status")
  @@index([constituencyCode, status], map: "idx_positions_constituency_status")
  @@index([lgaCode, status], map: "idx_positions_lga_status")
  @@index([wardCode, status], map: "idx_positions_ward_status")
  @@index([officialId], map: "idx_positions_official")
  @@map("official_positions")
}

model PoliticalTerm {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(100)
  termNumber Int?      @map("term_number")
  level      String    @db.VarChar(10)
  kind       String    @db.VarChar(20)
  stateCode  String?   @map("state_code") @db.VarChar(30)
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date

  state      NigerianState?      @relation(fields: [stateCode], references: [code])
  positions  OfficialPosition[]
  committees OfficialCommittee[]

  @@unique([level, kind, stateCode, termNumber], map: "uq_term_level_kind_state_number")
  @@map("political_terms")
}

model PoliticalParty {
  acronym  String  @id @db.VarChar(20)
  name     String  @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  // Enrichable profile fields (agent-sourced). All nullable.
  logoUrl       String? @map("logo_url") @db.VarChar(500)
  foundingYear  Int?    @map("founding_year")
  leaderName    String? @map("leader_name") @db.VarChar(200)
  hqAddress     String? @map("hq_address") @db.Text
  website       String? @db.VarChar(500)
  email         String? @db.VarChar(255)
  phoneNumber   String? @map("phone_number") @db.VarChar(30)
  twitterHandle String? @map("twitter_handle") @db.VarChar(100)
  facebookUrl   String? @map("facebook_url") @db.VarChar(500)
  description   String? @db.Text
  ideology      String? @db.VarChar(100)
  slogan        String? @db.VarChar(255)
  color         String? @db.VarChar(20)
  inecStatus    String? @map("inec_status") @db.VarChar(50)

  completenessScore Decimal? @map("completeness_score") @db.Decimal(3, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  positions    OfficialPosition[]
  chapters     PartyStateChapter[]
  affiliations OfficialPartyAffiliation[]
  elections    OfficialElection[]
  officers     PartyOfficer[]

  @@map("political_parties")
}

// National leadership of a party (chairman / secretary / party leader). Source of
// truth for party officers; `leaderName` above is deprecated, backfilled into a
// `national_chairman` row here. Enrichable via the plan-45 pipeline.
model PartyOfficer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyAcronym   String    @map("party_acronym") @db.VarChar(20)
  role           String    @db.VarChar(40)
  name           String    @db.VarChar(200)
  imageUrl       String?   @map("image_url") @db.VarChar(500)
  // Links to the officer's full official record when one exists/was seeded.
  // name/imageUrl above are kept as a denormalized display fallback.
  officialId     String?   @map("official_id") @db.Uuid
  displayOrder   Int       @default(0) @map("display_order")
  sourceType     String    @default("manual") @map("source_type") @db.VarChar(20)
  sourceUrl      String?   @map("source_url") @db.Text
  confidence     String    @default("medium") @db.VarChar(10)
  reviewStatus   String    @default("unreviewed") @map("review_status") @db.VarChar(20)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  party    PoliticalParty    @relation(fields: [partyAcronym], references: [acronym])
  official NigerianOfficial? @relation(fields: [officialId], references: [id])

  @@unique([partyAcronym, role], map: "uq_party_officer_role")
  @@index([partyAcronym], map: "idx_party_officers_party")
  @@index([officialId], map: "idx_party_officers_official")
  @@map("party_officers")
}

// Per-state party chapter. Seeded for every (party, state) where the party holds
// an active OfficialPosition; others created on demand via the agent `create` flow.
model PartyStateChapter {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyAcronym  String  @map("party_acronym") @db.VarChar(20)
  stateCode     String  @map("state_code") @db.VarChar(30)
  chairmanName  String? @map("chairman_name") @db.VarChar(200)
  secretaryName String? @map("secretary_name") @db.VarChar(200)
  hqAddress     String? @map("hq_address") @db.Text
  phoneNumber   String? @map("phone_number") @db.VarChar(30)
  email         String? @db.VarChar(255)
  website       String? @db.VarChar(500)
  twitterHandle String? @map("twitter_handle") @db.VarChar(100)

  completenessScore Decimal? @map("completeness_score") @db.Decimal(3, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  party PoliticalParty @relation(fields: [partyAcronym], references: [acronym])
  state NigerianState  @relation(fields: [stateCode], references: [code])

  @@unique([partyAcronym, stateCode], map: "uq_party_state_chapter")
  @@index([stateCode], map: "idx_party_chapters_state")
  @@map("party_state_chapters")
}

model NigerianWard {
  code    String  @id @db.VarChar(100)
  name    String  @db.VarChar(150)
  lgaCode String  @map("lga_code") @db.VarChar(60)
  pcode   String? @db.VarChar(20)

  lga                  NigerianLga        @relation(fields: [lgaCode], references: [code])
  constituencyMappings ConstituencyWard[]
  officialPositions    OfficialPosition[]
  officialElections    OfficialElection[]

  @@index([lgaCode], map: "idx_wards_lga")
  @@map("nigerian_wards")
}

model SenatorialDistrictLga {
  senatorialDistrictCode String    @map("senatorial_district_code") @db.VarChar(80)
  lgaCode                String    @map("lga_code") @db.VarChar(60)
  source                 String    @db.VarChar(30)
  sourceUrl              String?   @map("source_url") @db.Text
  sourceDate             DateTime? @map("source_date") @db.Date
  confidence             String    @default("high") @db.VarChar(10)

  senatorialDistrict NigerianConstituency @relation(fields: [senatorialDistrictCode], references: [code])
  lga                NigerianLga          @relation(fields: [lgaCode], references: [code])

  @@id([senatorialDistrictCode, lgaCode])
  @@index([lgaCode], map: "idx_senatorial_lga_lga")
  @@map("senatorial_district_lgas")
}

model ConstituencyWard {
  constituencyCode String    @map("constituency_code") @db.VarChar(80)
  wardCode         String    @map("ward_code") @db.VarChar(100)
  source           String    @db.VarChar(30)
  sourceUrl        String?   @map("source_url") @db.Text
  sourceDate       DateTime? @map("source_date") @db.Date
  confidence       String    @default("medium") @db.VarChar(10)

  constituency NigerianConstituency @relation(fields: [constituencyCode], references: [code])
  ward         NigerianWard         @relation(fields: [wardCode], references: [code])

  @@id([constituencyCode, wardCode])
  @@index([wardCode], map: "idx_constituency_ward_ward")
  @@map("constituency_wards")
}

// ============================================================
// Civic Crowdsource (proposals, votes, activity)
// ============================================================

// ============================================================
// Official structured profile data (Plan 45)
// Biographical tables apply to ANY official type; the political
// layer (party/committees/bills/elections) is optional per person.
// Every fact carries provenance columns; multi-source evidence
// lives in the shared polymorphic `evidence` table below.
// CHECK constraints for enum-like columns are in migration SQL.
// ============================================================

model OfficialEducation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officialId      String    @map("official_id") @db.Uuid
  institution     String    @db.VarChar(255)
  institutionType String?   @map("institution_type") @db.VarChar(20)
  qualification   String?   @db.VarChar(120)
  field           String?   @db.VarChar(150)
  startYear       Int?      @map("start_year")
  endYear         Int?      @map("end_year")
  graduated       Boolean?
  location        String?   @db.VarChar(150)
  confidence      String    @default("medium") @db.VarChar(10)
  sourceType      String    @default("manual") @map("source_type") @db.VarChar(20)
  reviewStatus    String    @default("unreviewed") @map("review_status") @db.VarChar(20)
  reviewedBy      String?   @map("reviewed_by") @db.VarChar(100)
  lastVerifiedAt  DateTime? @map("last_verified_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  official NigerianOfficial @relation(fields: [officialId], references: [id], onDelete: Cascade)

  @@index([officialId], map: "idx_education_official")
  @@map("official_education")
}

/// Pre-politics / professional career entries.
model OfficialCareer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officialId     String    @map("official_id") @db.Uuid
  organization   String    @db.VarChar(255)
  role           String?   @db.VarChar(150)
  industry       String?   @db.VarChar(100)
  employmentType String?   @map("employment_type") @db.VarChar(20)
  startYear      Int?      @map("start_year")
  endYear        Int?      @map("end_year")
  description    String?   @db.Text
  confidence     String    @default("medium") @db.VarChar(10)
  sourceType     String    @default("manual") @map("source_type") @db.VarChar(20)
  reviewStatus   String    @default("unreviewed") @map("review_status") @db.VarChar(20)
  reviewedBy     String?   @map("reviewed_by") @db.VarChar(100)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  official NigerianOfficial @relation(fields: [officialId], references: [id], onDelete: Cascade)

  @@index([officialId], map: "idx_careers_official")
  @@map("official_careers")
}

model OfficialPartyAffiliation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officialId     String    @map("official_id") @db.Uuid
  partyAcronym   String    @map("party_acronym") @db.VarChar(20)
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  reason         String?   @db.Text
  confidence     String    @default("medium") @db.VarChar(10)
  sourceType     String    @default("manual") @map("source_type") @db.VarChar(20)
  reviewStatus   String    @default("unreviewed") @map("review_status") @db.VarChar(20)
  reviewedBy     String?   @map("reviewed_by") @db.VarChar(100)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  official NigerianOfficial @relation(fields: [officialId], references: [id], onDelete: Cascade)
  party    PoliticalParty   @relation(fields: [partyAcronym], references: [acronym])

  @@index([officialId], map: "idx_party_affiliations_official")
  @@map("official_party_affiliations")
}

model OfficialCommittee {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officialId     String    @map("official_id") @db.Uuid
  committeeName  String    @map("committee_name") @db.VarChar(255)
  chamber        String    @db.VarChar(30)
  role           String    @default("member") @db.VarChar(20)
  positionId     String?   @map("position_id") @db.Uuid
  termId         String?   @map("term_id") @db.Uuid
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  confidence     String    @default("medium") @db.VarChar(10)
  sourceType     String    @default("manual") @map("source_type") @db.VarChar(20)
  reviewStatus   String    @default("unreviewed") @map("review_status") @db.VarChar(20)
  reviewedBy     String?   @map("reviewed_by") @db.VarChar(100)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  official NigerianOfficial  @relation(fields: [officialId], references: [id], onDelete: Cascade)
  position OfficialPosition? @relation(fields: [positionId], references: [id])
  term     PoliticalTerm?    @relation(fields: [termId], references: [id])

