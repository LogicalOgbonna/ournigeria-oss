// ============================================================
// Corruption case dataset (Plan 45) — independent domain.
// Deliberately NOT coupled to officials: parties link via a
// polymorphic subject (subjectType + subjectId + subjectName)
// so future appointed officials / companies need zero rework.
// ============================================================

model CorruptionCase {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String    @unique @db.VarChar(160)
  title          String    @db.VarChar(300)
  summary        String?   @db.Text
  caseType       String    @map("case_type") @db.VarChar(30)
  status         String    @db.VarChar(30)
  forum          String?   @db.VarChar(30)
  amountInvolved Decimal?  @map("amount_involved") @db.Decimal(18, 2)
  amountRecovered Decimal? @map("amount_recovered") @db.Decimal(18, 2)
  currency       String    @default("NGN") @db.VarChar(10)
  stateCode      String?   @map("state_code") @db.VarChar(30)
  sector         String?   @db.VarChar(50)
  openedDate     DateTime? @map("opened_date") @db.Date
  chargeDate     DateTime? @map("charge_date") @db.Date
  verdictDate    DateTime? @map("verdict_date") @db.Date
  outcome        String?   @db.Text
  sentence       String?   @db.Text
  isLandmark     Boolean   @default(false) @map("is_landmark")
  confidence     String    @default("medium") @db.VarChar(10)
  sourceType     String    @default("manual") @map("source_type") @db.VarChar(20)
  reviewStatus   String    @default("unreviewed") @map("review_status") @db.VarChar(20)
  reviewedBy     String?   @map("reviewed_by") @db.VarChar(100)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  state      NigerianState?         @relation(fields: [stateCode], references: [code])
  parties    CorruptionCaseParty[]
  updates    CorruptionCaseUpdate[]
  legalCases OfficialLegalCase[]

  @@index([status], map: "idx_corruption_cases_status")
  @@index([stateCode], map: "idx_corruption_cases_state")
  @@map("corruption_cases")
}

/// Polymorphic subject: subjectId resolves to nigerian_officials when
/// subjectType='official'; future types (appointed_official, company…) resolve
