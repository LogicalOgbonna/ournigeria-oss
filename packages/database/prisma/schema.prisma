model SocialPost {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform       String    @db.VarChar(20) // 'twitter'
  postType       String    @map("post_type") @db.VarChar(30) // 'thread', 'opinion_tweet', 'reply'
  externalId     String?   @map("external_id") @db.VarChar(100) // Twitter tweet ID after posting
  content        String    @db.Text // Full post content (JSON for threads)
  triggerTopic   String?   @map("trigger_topic") @db.VarChar(200) // What trend/keyword triggered this
  dataDomain     String?   @map("data_domain") @db.VarChar(20) // 'budget', 'corruption', 'faac', 'govspend'
  dataQuery      String?   @map("data_query") @db.Text // The query sent to data tools
  status         String    @default("drafted") @db.VarChar(20) // drafted, published, failed, rejected
  publishedAt    DateTime? @map("published_at") @db.Timestamptz()
  engagementData Json?     @map("engagement_data") @db.JsonB // {likes, retweets, replies, bookmarks}
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Reply-specific fields
  inReplyToId   String?   @map("in_reply_to_id") @db.VarChar(100) // Twitter ID of tweet being replied to
  inReplyToText String?   @map("in_reply_to_text") @db.Text // Text of original tweet
  inReplyToUser String?   @map("in_reply_to_user") @db.VarChar(100) // Username of original tweeter
  confidence    Float? // 0-1 composite score
  reviewStatus  String?   @map("review_status") @db.VarChar(20) // 'pending', 'approved', 'rejected', 'edited'
  reviewedBy    String?   @map("reviewed_by") @db.Uuid // Admin user ID who approved/rejected
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz()

  // Quote/draft pipeline fields (roamer + drafter)
  quotedTweetId         String? @map("quoted_tweet_id") @db.VarChar(100) // Twitter ID of quoted tweet
  originalTweetSnapshot Json?   @map("original_tweet_snapshot") @db.JsonB // Frozen author+tweet payload for preview
  safetyWarnings        Json?   @map("safety_warnings") @db.JsonB // string[] from SafetyFilter
  agentConfidence       Float?  @map("agent_confidence") // 0-1, agent's self-rated confidence
  agentReasoning        String? @map("agent_reasoning") @db.Text
  classifierScore       Float?  @map("classifier_score")
  classifierIntent      String? @map("classifier_intent") @db.VarChar(50)
  discoveredTweetId     String? @unique @map("discovered_tweet_id") @db.VarChar(100)
  // Mirrors SocialsDiscoveredTweet.source onto the draft: 'roam' |
  // 'inbound_reply' | 'mention'. Lets the dashboard badge/filter by source and
  // the roamer funnel/analytics exclude inbound. Null on legacy rows.
  source                String? @map("source") @db.VarChar(20)

  discoveredTweet SocialsDiscoveredTweet? @relation(fields: [discoveredTweetId], references: [id], onDelete: SetNull)

  @@index([platform, status], map: "idx_social_posts_platform_status")
  @@index([platform, createdAt(sort: Desc)], map: "idx_social_posts_platform_date")
  @@index([reviewStatus], map: "idx_social_posts_review_status")
  @@map("social_posts")
}

/// Cluster-singleton lock + audit for the identify campaign. One row per
/// (windowDate, windowSlot); the first socials node to INSERT it owns that
/// window (blue/green safe — replaces the FAAC cron's in-process boolean).
model IdentifyCampaignRun {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  windowDate    DateTime @map("window_date") @db.Date
  windowSlot    Int      @map("window_slot")
  claimedByPid  Int      @map("claimed_by_pid")
  claimedByHost String   @map("claimed_by_host") @db.VarChar(120)
  startedAt     DateTime @default(now()) @map("started_at") @db.Timestamptz()
  postedCount   Int      @default(0) @map("posted_count")

  @@unique([windowDate, windowSlot], map: "uq_identify_run_window")
  @@map("identify_campaign_runs")
}

/// The without-replacement ledger — one row per seat we've tweeted (or parked
/// a draft for). Its existence removes the seat from future selection. `status`
/// is "posted" (auto-posted or human-approved) or "drafted" (parked).
model IdentifyCampaignTarget {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category     String   @db.VarChar(20)
  seatColumn   String   @map("seat_column") @db.VarChar(20)
  seatCode     String   @map("seat_code") @db.VarChar(100)
  stateCode    String   @map("state_code") @db.VarChar(30)
  positionId   String?  @map("position_id") @db.Uuid
  socialPostId String?  @map("social_post_id") @db.Uuid
  tweetId      String?  @map("tweet_id") @db.VarChar(100)
  status       String   @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([category, seatCode], map: "uq_identify_target_seat")
  @@index([category, status], map: "idx_identify_target_category_status")
  @@map("identify_campaign_targets")
}

model ProposalVerifyPost {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anchorType   String   @map("anchor_type") @db.VarChar(20)
  anchorId     String   @map("anchor_id") @db.VarChar(100)
  proposalId   String   @map("proposal_id") @db.Uuid
  kind         String   @db.VarChar(20)
  socialPostId String?  @map("social_post_id") @db.Uuid
  tweetId      String?  @map("tweet_id") @db.VarChar(100)
  status       String   @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([anchorType, anchorId], map: "uq_proposal_verify_anchor")
  @@index([status], map: "idx_proposal_verify_status")
  @@map("proposal_verify_posts")
}

// ============================================================
// Socials Roamer (Twitter discovery + drafting pipeline)
// ============================================================
// Browser-session scraping of Twitter SearchTimeline GraphQL,
// per-tweet LLM classification, decoupled drafter worker.
// Tables prefixed `socials_` to keep ownership boundary clear.

model SocialsBotSession {
  id                     String    @id @default(uuid()) @db.Uuid
  cookie                 String    @db.Text
  csrfToken              String    @map("csrf_token") @db.Text
  authorization          String    @db.Text
  xClientTransactionId   String    @map("x_client_transaction_id") @db.Text
  xClientUuid            String    @map("x_client_uuid") @db.Text
  userName               String    @map("user_name") @db.VarChar(100)
  path                   String    @db.VarChar(200)
  searchTimelineOpHash   String?   @map("search_timeline_op_hash") @db.VarChar(100)
  tweetDetailOpHash      String?   @map("tweet_detail_op_hash") @db.VarChar(100)
  status                 String    @default("idle") @db.VarChar(20) // idle | working | auth_failed
  cooldownUntil          DateTime? @map("cooldown_until") @db.Timestamptz()
  // Separate from cooldownUntil (the roamer's SearchTimeline pacing): a
  // TweetDetail 429 backs off conversation reads WITHOUT sidelining the session
  // from roaming, and vice versa.
  tweetDetailCooldownUntil DateTime? @map("tweet_detail_cooldown_until") @db.Timestamptz()
  startedWorkingAt       DateTime? @map("started_working_at") @db.Timestamptz()
  stoppedWorkingAt       DateTime? @map("stopped_working_at") @db.Timestamptz()
  lastUsedAt             DateTime  @map("last_used_at") @db.Timestamptz()
  lastError              String?   @map("last_error") @db.Text
  consecutiveErrors      Int       @default(0) @map("consecutive_errors")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  runs SocialsSessionRun[]

  @@unique([userName, path], map: "uq_socials_bot_session_user_path")
  @@index([status, cooldownUntil], map: "idx_socials_bot_session_claimable")
  @@map("socials_bot_session")
}

model SocialsTopic {
  id               String    @id @default(uuid()) @db.Uuid
  name             String    @unique @db.VarChar(150)
  query            String    @db.Text
  enabled          Boolean   @default(false)
  cursor           String?   @db.Text
  description      String    @db.Text
  positiveExamples String[]  @default([]) @map("positive_examples")
  negativeExamples String[]  @default([]) @map("negative_examples")
  domain           String    @db.VarChar(20) // budget | corruption | govspend | faac | general
  threshold        Float     @default(0.7)
  minFollowers     Int       @default(1000) @map("min_followers")
  maxFollowers     Int       @default(500000) @map("max_followers")
  lang             String    @default("en") @db.VarChar(10)
  minTextLength    Int       @default(20) @map("min_text_length")
  maxAgeHours      Int       @default(48) @map("max_age_hours")
  lastRunAt        DateTime? @map("last_run_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  classifications SocialsTweetClassification[]
  seen            SocialsTweetSeen[]
  runs            SocialsSessionRun[]

  @@index([enabled, lastRunAt], map: "idx_socials_topic_stale")
  @@map("socials_topic")
}

model SocialsDiscoveredTweet {
  id                    String   @id @db.VarChar(100) // X tweet id (string, not uuid)
  authorRestId          String   @map("author_rest_id") @db.VarChar(100)
  authorScreenName      String   @map("author_screen_name") @db.VarChar(100)
  authorName            String   @map("author_name") @db.VarChar(200)
  authorBio             String   @map("author_bio") @db.Text
  authorFollowers       Int      @map("author_followers")
  authorProfileImageUrl String?  @map("author_profile_image_url") @db.Text
  text                  String   @db.Text
  lang                  String?  @db.VarChar(10)
  replyCount            Int      @default(0) @map("reply_count")
  quoteCount            Int      @default(0) @map("quote_count")
  retweetCount          Int      @default(0) @map("retweet_count")
  likeCount             Int      @default(0) @map("like_count")
  isQuote               Boolean  @default(false) @map("is_quote")
  isReply               Boolean  @default(false) @map("is_reply")
  // Thread context (Phase 2): parent tweet + conversation root so the drafter
  // can read the tweets above a reply, and the quoted tweet's text so it can see
  // what a quote-tweet is quoting — both captured at discovery.
  inReplyToTweetId      String?  @map("in_reply_to_tweet_id") @db.VarChar(100)
  conversationId        String?  @map("conversation_id") @db.VarChar(100)
  quotedText            String?  @map("quoted_text") @db.Text
  quotedAuthorHandle    String?  @map("quoted_author_handle") @db.VarChar(100)
  // Phase 3 reply inbox: where this tweet came from. 'roam' = discovered via
  // topic search (default); 'inbound_reply' = a reply under one of our posts;
  // 'mention' = an @ mention of the account. ourPostId links an inbound_reply
  // back to the SocialPost it sits under (null for roam/mention).
  source                String   @default("roam") @map("source") @db.VarChar(20)
  ourPostId             String?  @map("our_post_id") @db.VarChar(100)
  tweetCreatedAt        DateTime @map("tweet_created_at") @db.Timestamptz()
  draftStatus           String?  @map("draft_status") @db.VarChar(20) // null | drafted | error | skipped
  draftAttempts         Int      @default(0) @map("draft_attempts")
  draftError            String?  @map("draft_error") @db.Text
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz()

  classifications SocialsTweetClassification[]
  draft           SocialPost?

  @@index([authorRestId], map: "idx_socials_discovered_tweet_author")
  @@index([draftStatus, createdAt], map: "idx_socials_discovered_tweet_draft_status")
  @@map("socials_discovered_tweet")
}

model SocialsTweetClassification {
  tweetId         String   @map("tweet_id") @db.VarChar(100)
  topicId         String   @map("topic_id") @db.Uuid
  modelVersion    String   @map("model_version") @db.VarChar(50)
  score           Float
  reason          String   @db.Text
  intent          String   @db.VarChar(50)
  passedThreshold Boolean  @map("passed_threshold")
  classifiedAt    DateTime @default(now()) @map("classified_at") @db.Timestamptz()

  tweet SocialsDiscoveredTweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  topic SocialsTopic           @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([tweetId, topicId, modelVersion])
  @@index([topicId, passedThreshold, classifiedAt], map: "idx_socials_tweet_classification_topic_passed")
  @@map("socials_tweet_classification")
}

model SocialsTweetSeen {
  tweetId         String   @map("tweet_id") @db.VarChar(100)
  topicId         String   @map("topic_id") @db.Uuid
  classifiedAt    DateTime @default(now()) @map("classified_at") @db.Timestamptz()
  passedThreshold Boolean  @map("passed_threshold")

  topic SocialsTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([tweetId, topicId])
  @@index([classifiedAt], map: "idx_socials_tweet_seen_classified_at")
  @@map("socials_tweet_seen")
}

model SocialsSessionRun {
  id                String    @id @default(uuid()) @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  topicId           String    @map("topic_id") @db.Uuid
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz()
  stopReason        String?   @map("stop_reason") @db.VarChar(50)
  tweetsScanned     Int       @default(0) @map("tweets_scanned")
  tweetsFiltered    Int       @default(0) @map("tweets_filtered")
  tweetsClassified  Int       @default(0) @map("tweets_classified")
  matchesStored     Int       @default(0) @map("matches_stored")
  errorMessage      String?   @map("error_message") @db.Text

  session SocialsBotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topic   SocialsTopic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([startedAt], map: "idx_socials_session_run_started_at")
  @@map("socials_session_run")
}

model SocialsRoamState {
  id                  Int       @id @default(1) // single-row table, always id=1
  pid                 Int?
  host                String?   @db.VarChar(200)
  heartbeatAt         DateTime? @map("heartbeat_at") @db.Timestamptz()
  alertNoSessions     Boolean   @default(false) @map("alert_no_sessions")
  alertNoTopics       Boolean   @default(false) @map("alert_no_topics")
  agentBudgetAlert    Boolean   @default(false) @map("agent_budget_alert")
  drafterBacklogAlert Boolean   @default(false) @map("drafter_backlog_alert")

  @@map("socials_roam_state")
}

model SocialsXOauthTokens {
  id           Int      @id @default(1) // single-row table, always id=1
  accessToken  String   @map("access_token") @db.Text
  refreshToken String   @map("refresh_token") @db.Text
  username     String?  @map("username") @db.Text // X handle of the connected account (nullable for pre-existing rows)
  rotatedAt    DateTime @default(now()) @map("rotated_at") @db.Timestamptz()

  @@map("socials_x_oauth_tokens")
}

// ============================================================
// Fiscal Data Models
// ============================================================
// CHECK constraints, partial unique indexes, and cross-entity
// consistency triggers are in migration SQL (Prisma doesn't support
// them natively). See design/fiscal-data-models-erd.md for full
// constraint definitions.

enum FiscalEntityType {
  federal
  state
  lga

  @@map("fiscal_entity_type")
}

enum BudgetType {
  recurrent_revenue
  recurrent_expenditure
  capital_expenditure
  capital_receipt

  @@map("budget_type")
}

enum DebtType {
  domestic
  external

  @@map("debt_type")
}

model FederalGovernment {
  code                String   @id @db.VarChar(10) // always 'federal'
  name                String   @db.VarChar(100)
  capital             String   @db.VarChar(50)
  presidentName       String?  @map("president_name") @db.VarChar(200)
  vicePresidentName   String?  @map("vice_president_name") @db.VarChar(200)
  senatePresidentName String?  @map("senate_president_name") @db.VarChar(200)
  speakerName         String?  @map("speaker_name") @db.VarChar(200)
  sgfName             String?  @map("sgf_name") @db.VarChar(200)
  chiefJusticeName    String?  @map("chief_justice_name") @db.VarChar(200)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  fiscalEntity FiscalEntity?

  @@map("federal_government")
}

/// Universal identity bridge for all fiscal tables.
/// 812 rows: 1 federal + 37 states + 774 LGAs.
/// CHECK constraint chk_fiscal_entity_exclusive_arc ensures exactly one FK
/// is non-null and matches entity_type. Defined in migration SQL.
model FiscalEntity {
  code        String           @id @db.VarChar(60)
  name        String           @db.VarChar(200)
  entityType  FiscalEntityType @map("entity_type")
  federalCode String?          @unique @map("federal_code") @db.VarChar(10)
  stateCode   String?          @unique @map("state_code") @db.VarChar(30)
  lgaCode     String?          @unique @map("lga_code") @db.VarChar(60)

  federal FederalGovernment? @relation(fields: [federalCode], references: [code])
  state   NigerianState?     @relation(fields: [stateCode], references: [code])
  lga     NigerianLga?       @relation(fields: [lgaCode], references: [code])

  documents            Document[]
  budgetAdminCodes     BudgetAdminCode[]
  budgetProgrammes     BudgetProgramme[]
  budgetLocations      BudgetLocation[]
  budgetLineItems      BudgetLineItem[]
  budgetActuals        BudgetActual[]
  budgetMetadata       BudgetMetadata[]
  federalSpending      FederalSpending[]
  igrRecords           IgrRecord[]
  debtRecords          DebtRecord[]
  faacStateAllocations FaacStateAllocation[]
  faacLgaAllocations   FaacLgaAllocation[]
  gdpRecords           GdpRecord[]
  populationEstimates  PopulationEstimate[]
  budgetDocumentSections BudgetDocumentSection[]
  budgetProjects         BudgetProject[]

  @@map("fiscal_entities")
}

// ============================================================
// NCoA Dimension Tables
// ============================================================

/// Admin codes (MDAs) — vary per entity. Same code = different MDA per state.
/// Surrogate PK for FK references; natural unique (code, entity_code) for dedupe.
/// Cross-entity consistency: migration SQL adds a trigger ensuring
/// BudgetLineItem.entity_code matches BudgetAdminCode.entity_code via admin_id.
model BudgetAdminCode {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String   @db.VarChar(12)
  entityCode String   @map("entity_code") @db.VarChar(60)
  name       String   @db.Text
  level      Int      @db.SmallInt
  parentId   String?  @map("parent_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  entity    FiscalEntity      @relation(fields: [entityCode], references: [code])
  parent    BudgetAdminCode?  @relation("AdminParent", fields: [parentId], references: [id])
  children  BudgetAdminCode[] @relation("AdminParent")
  lineItems BudgetLineItem[]
  actuals   BudgetActual[]
  primaryProjects BudgetProject[]

  @@unique([code, entityCode], map: "uq_admin_code_entity")
  @@index([entityCode], map: "idx_admin_codes_entity")
  @@map("budget_admin_codes")
}

/// Economic codes — nationally standardized (NCoA). Code-only PK.
model BudgetEconomicCode {
  code       String   @id @db.VarChar(50)
  name       String   @db.Text
  level      Int      @db.SmallInt
  parentCode String?  @map("parent_code") @db.VarChar(50)
  type       String   @db.VarChar(15) // "revenue" | "expenditure"
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  parent    BudgetEconomicCode?  @relation("EconParent", fields: [parentCode], references: [code])
  children  BudgetEconomicCode[] @relation("EconParent")
  lineItems BudgetLineItem[]
  actuals   BudgetActual[]

  @@map("budget_economic_codes")
}

/// Function codes — nationally standardized (COFOG). Code-only PK.
model BudgetFunctionCode {
  code       String   @id @db.VarChar(5)
  name       String   @db.Text
  level      Int      @db.SmallInt
  parentCode String?  @map("parent_code") @db.VarChar(5)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  parent    BudgetFunctionCode?  @relation("FuncParent", fields: [parentCode], references: [code])
  children  BudgetFunctionCode[] @relation("FuncParent")
  lineItems BudgetLineItem[]
  actuals   BudgetActual[]

  @@map("budget_function_codes")
}

/// Fund codes — nationally standardized. Code-only PK.
model BudgetFundCode {
  code      String   @id @db.VarChar(5)
  name      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  lineItems BudgetLineItem[]

  @@map("budget_fund_codes")
}

/// Programmes — vary per entity. Surrogate PK + natural unique.
model BudgetProgramme {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String   @db.VarChar(14)
  name       String   @db.Text
  entityCode String   @map("entity_code") @db.VarChar(60)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  entity    FiscalEntity     @relation(fields: [entityCode], references: [code])
  lineItems BudgetLineItem[]
  actuals   BudgetActual[]
  primaryProjects BudgetProject[]

  @@unique([code, entityCode], map: "uq_programme_code_entity")
  @@index([entityCode], map: "idx_programmes_entity")
  @@map("budget_programmes")
}

/// Location codes — vary per entity. Surrogate PK + natural unique.
model BudgetLocation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String   @db.VarChar(8)
  name       String   @db.Text
  entityCode String   @map("entity_code") @db.VarChar(60)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  entity    FiscalEntity     @relation(fields: [entityCode], references: [code])
  lineItems BudgetLineItem[]
  projectLocations BudgetProjectLocation[]

  canonicalLgaCode String?      @map("canonical_lga_code") @db.VarChar(60)
  isStateWide      Boolean      @default(false) @map("is_state_wide")
  canonicalLga     NigerianLga? @relation(fields: [canonicalLgaCode], references: [code])

  @@unique([code, entityCode], map: "uq_location_code_entity")
  @@index([entityCode], map: "idx_locations_entity")
  @@map("budget_locations")
}

// ============================================================
// Budget Fact Tables
// ============================================================

model BudgetDocumentSection {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityCode       String   @map("entity_code") @db.VarChar(60)
  fiscalYear       Int      @map("fiscal_year") @db.SmallInt
  documentKind     String   @map("document_kind") @db.VarChar(50)
  sectionKey       String   @map("section_key") @db.VarChar(100)
  title            String   @db.Text
  parentSectionId  String?  @map("parent_section_id") @db.Uuid
  sortOrder        Int      @default(0) @map("sort_order")
  sourceDocumentId String?  @map("source_document_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  entity         FiscalEntity            @relation(fields: [entityCode], references: [code])
  parentSection  BudgetDocumentSection?  @relation("SectionHierarchy", fields: [parentSectionId], references: [id])
  childSections  BudgetDocumentSection[] @relation("SectionHierarchy")
  sourceDocument Document?               @relation(fields: [sourceDocumentId], references: [id])
  lineItems      BudgetLineItem[]
  actuals        BudgetActual[]

  @@unique([entityCode, fiscalYear, documentKind, sectionKey], map: "uq_budget_section")
  @@index([entityCode, fiscalYear], map: "idx_budget_section_entity_year")
  @@map("budget_document_sections")
}

model BudgetProject {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityCode         String   @map("entity_code") @db.VarChar(60)
  fiscalYear         Int      @map("fiscal_year") @db.SmallInt
  name               String   @db.Text
  externalCode       String?  @map("external_code") @db.VarChar(100)
  primaryAdminId     String?  @map("primary_admin_id") @db.Uuid
  primaryProgrammeId String?  @map("primary_programme_id") @db.Uuid
  climateRelated     Boolean  @default(false) @map("climate_related")
  nutritionRelated   Boolean  @default(false) @map("nutrition_related")
  isStateWide        Boolean  @default(false) @map("is_state_wide")
  sourceDocumentId   String?  @map("source_document_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  entity           FiscalEntity            @relation(fields: [entityCode], references: [code])
  primaryAdmin     BudgetAdminCode?        @relation(fields: [primaryAdminId], references: [id])
  primaryProgramme BudgetProgramme?        @relation(fields: [primaryProgrammeId], references: [id])
  sourceDocument   Document?               @relation(fields: [sourceDocumentId], references: [id])
  locations        BudgetProjectLocation[]
  lineItems        BudgetLineItem[]
  actuals          BudgetActual[]

  @@unique([entityCode, fiscalYear, externalCode], map: "uq_budget_project_ext_code")
  @@index([entityCode, fiscalYear], map: "idx_budget_project_entity_year")
  // Note: PR specifies optional helper index for name lookup, Prisma supports index on Text
  @@index([entityCode, fiscalYear, name], map: "idx_budget_project_name")
  @@map("budget_projects")
}

model BudgetProjectLocation {
  projectId String   @map("project_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  weight     Decimal? @db.Decimal(5, 2)

  project  BudgetProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location BudgetLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([projectId, locationId])
  @@map("budget_project_locations")
}

/// Approved budget line items. ~1M rows.
/// Cross-entity consistency constraint in migration SQL:
///   admin_id -> budget_admin_codes.entity_code MUST equal this.entity_code
///   programme_id -> budget_programmes.entity_code MUST equal this.entity_code
///   location_id -> budget_locations.entity_code MUST equal this.entity_code
model BudgetLineItem {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityCode       String     @map("entity_code") @db.VarChar(60)
  fiscalYear       Int        @map("fiscal_year") @db.SmallInt
  adminId          String     @map("admin_id") @db.Uuid
  economicCode     String?    @map("economic_code") @db.VarChar(50)
  functionCode     String?    @map("function_code") @db.VarChar(5)
  fundCode         String?    @map("fund_code") @db.VarChar(5)
  locationId       String?    @map("location_id") @db.Uuid
  programmeId      String?    @map("programme_id") @db.Uuid
  budgetType       BudgetType @map("budget_type")
  description      String?    @db.Text
  prevYearBudget   Decimal?   @map("prev_year_budget") @db.Decimal(20, 2)
  prevYearActual   Decimal?   @map("prev_year_actual") @db.Decimal(20, 2)
  approvedBudget   Decimal    @map("approved_budget") @db.Decimal(20, 2)
  outYear1         Decimal?   @map("out_year_1") @db.Decimal(20, 2)
  outYear2         Decimal?   @map("out_year_2") @db.Decimal(20, 2)
  sourceDocumentId String?    @map("source_document_id") @db.Uuid
  sourcePage       Int?       @map("source_page")
  sourceAnchor     String?    @map("source_anchor") @db.Text
  sectionId        String?    @map("section_id") @db.Uuid
  projectId        String?    @map("project_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  entity         FiscalEntity          @relation(fields: [entityCode], references: [code])
  admin          BudgetAdminCode       @relation(fields: [adminId], references: [id])
  economic       BudgetEconomicCode?   @relation(fields: [economicCode], references: [code])
  function       BudgetFunctionCode?   @relation(fields: [functionCode], references: [code])
  fund           BudgetFundCode?       @relation(fields: [fundCode], references: [code])
  location       BudgetLocation?       @relation(fields: [locationId], references: [id])
  programme      BudgetProgramme?      @relation(fields: [programmeId], references: [id])
  sourceDocument Document?             @relation(fields: [sourceDocumentId], references: [id])
  section        BudgetDocumentSection? @relation(fields: [sectionId], references: [id])
  project        BudgetProject?        @relation(fields: [projectId], references: [id])

  // Uniqueness constraint in migration SQL (uses COALESCE for nullable fund_code)
  @@index([entityCode, fiscalYear], map: "idx_bli_entity_year")
  @@index([adminId], map: "idx_bli_admin")
  @@index([economicCode], map: "idx_bli_economic")
  @@index([entityCode, fiscalYear, sourcePage], map: "idx_bli_entity_year_source_page")
  @@index([fiscalYear, budgetType], map: "idx_bli_year_type")
  @@index([approvedBudget(sort: Desc)], map: "idx_bli_approved_desc")
  @@map("budget_line_items")
}

/// Budget implementation actuals. ~2-4M rows.
