// ============================================================
// Authentication, sessions & RBAC role assignments (admin + end-user identity)
// ============================================================

// ============================================================
// Models
// ============================================================

model AdminUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz()
  createdById  String?   @map("created_by_id") @db.Uuid

  createdBy    AdminUser?     @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers AdminUser[]    @relation("AdminCreatedBy")
  sessions     AdminSession[]

  @@map("admin_users")
}


/// Opaque, server-stored admin session. The cookie carries a random token
/// (prefix `ons_`); only its SHA-256 hash is stored here. Distinct from
/// admin.id so it can be expired and revoked per-session.
model AdminSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz()
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz()
  userAgent  String?   @map("user_agent") @db.VarChar(400)
  ip         String?   @db.VarChar(64)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "idx_admin_sessions_admin")
  @@index([expiresAt], map: "idx_admin_sessions_expires")
  @@map("admin_sessions")
}


// ============================================================
// RBAC + chain-of-trust audit logging (plan 62).
// Role DEFINITIONS live in code (@ournigeria/access); these tables
// hold assignments and the tamper-evident audit chain.
// ============================================================

/// Principal-keyed role assignment. principalType "staff" = AdminUser today;
/// "member" reserved for invited external researchers (phase 2). Revoked rows
/// are history — never deleted. Active-uniqueness is a partial index in the
/// migration SQL: uq_role_assignment_active WHERE revoked_at IS NULL.
model RoleAssignment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  principalType String    @map("principal_type") @db.VarChar(10)
  principalId   String    @map("principal_id") @db.Uuid
  role          String    @db.VarChar(40)
  /// Reserved for scoped access (e.g. {"states":["kano"]}). Null = global.
  /// Guards ignore it until a scope semantic is defined (spec §6).
  scope         Json?     @db.JsonB
  grantedById   String?   @map("granted_by_id") @db.Uuid
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz()
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz()
  revokedById   String?   @map("revoked_by_id") @db.Uuid
  reason        String?   @db.VarChar(500)

  @@index([principalType, principalId], map: "idx_role_assignment_principal")
  @@map("role_assignments")
}


model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber String?   @unique @map("phone_number") @db.VarChar(20)
  telegramId  String?   @unique @map("telegram_id") @db.VarChar(20)
  name        String?   @db.VarChar(100)
  email       String?   @db.VarChar(255)
  banned      Boolean   @default(false)
  bannedAt    DateTime? @map("banned_at") @db.Timestamptz()
  banReason   String?   @map("ban_reason") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz()
  preferences Json      @default("{}") @db.JsonB

  conversations    Conversation[]
  queryAnalytics   QueryAnalytic[]
  memories         UserMemory[]
  notifications    Notification[]
  dismissedBanners BannerDismissal[]
  feedbacks        Feedback[]
  donations        Donation[]
  sessions         UserSession[]
  authHandoffs     AuthHandoff[]

  @@map("users")
}


/// Opaque, server-stored user session. The cookie carries a random token
/// (prefix `nbs_`); only its SHA-256 hash is stored here. Distinct from user.id
/// so it can be rotated, expired, and revoked independently.
model UserSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz()
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz()
  userAgent  String?   @map("user_agent") @db.VarChar(400)
  ip         String?   @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_sessions_user")
  @@index([expiresAt], map: "idx_user_sessions_expires")
  @@map("user_sessions")
}


/// One-time, short-lived cross-origin login handoff code (prefix `nbh_`).
/// Carries no userId in the value; only its SHA-256 hash is stored. The web
/// app POSTs the code to /auth/handoff, which exchanges it for a UserSession.
model AuthHandoff {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "idx_auth_handoffs_expires")
  @@map("auth_handoffs")
}


model OtpVerification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber String   @map("phone_number") @db.VarChar(20)
  code        String   @db.VarChar(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz()
  attempts    Int      @default(0)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([phoneNumber, verified, expiresAt], map: "idx_otp_phone_active")
  @@map("otp_verifications")
}


// ============================================================
// Provider Connections (pre-configured LLM & Embedding profiles)
// ============================================================

model ProviderConnection {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(100)
  type       String   @db.VarChar(20) // "llm" or "embedding"
  provider   String   @db.VarChar(50)
  baseUrl    String   @map("base_url") @db.VarChar(500)
  apiKey     String   @map("api_key") @db.Text // AES-256-GCM encrypted
  modelId    String   @map("model_id") @db.VarChar(200)
  modelSmall String?  @map("model_small") @db.VarChar(200) // LLM only: small/fast model
  dimension  Int? // Embedding only: vector dimension
  isActive   Boolean  @default(false) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy  String?  @map("created_by") @db.Uuid

  @@index([type, isActive], map: "idx_provider_connections_type_active")
  @@map("provider_connections")
}


/// Short-lived single-use record backing the Telegram deep-link login flow.
/// `startParam` travels into Telegram via the t.me deep link (matched by the webhook);
/// `pollKey` stays in the browser (matched by the poll endpoint). See .agent/plans/46*.
model TelegramLoginRequest {
  id         String   @id @default(uuid()) @db.Uuid
  startParam String   @unique @map("start_param") @db.VarChar(64)
  pollKey    String   @unique @map("poll_key") @db.VarChar(64)
  status     String   @default("pending") @db.VarChar(20) // pending | authenticated | consumed
  intent     String   @default("login") @db.VarChar(10) // login | link
  telegramId String?  @map("telegram_id") @db.VarChar(20)
  userId     String?  @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz()
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([expiresAt])
  @@map("telegram_login_requests")
}
