/// Base relationships: father/mother/spouse/child; `relationship` stays open
/// (VarChar) so new kinds (sibling, in-law…) slot in. relatedOfficialId links
/// political dynasties to their own profiles.
model OfficialFamilyMember {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officialId        String    @map("official_id") @db.Uuid
  relationship      String    @db.VarChar(30)
  name              String?   @db.VarChar(200)
  relatedOfficialId String?   @map("related_official_id") @db.Uuid
  isPublicFigure    Boolean   @default(false) @map("is_public_figure")
  notes             String?   @db.Text
  confidence        String    @default("medium") @db.VarChar(10)
  sourceType        String    @default("manual") @map("source_type") @db.VarChar(20)
  reviewStatus      String    @default("unreviewed") @map("review_status") @db.VarChar(20)
  reviewedBy        String?   @map("reviewed_by") @db.VarChar(100)
  lastVerifiedAt    DateTime? @map("last_verified_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  official        NigerianOfficial  @relation(fields: [officialId], references: [id], onDelete: Cascade)
  relatedOfficial NigerianOfficial? @relation("FamilyRelatedOfficial", fields: [relatedOfficialId], references: [id])

  @@index([officialId], map: "idx_family_official")
  @@map("official_family_members")
}


/// Personal legal record (civil/electoral/criminal). Corruption matters live in
/// the corruption_cases domain; a personal entry that escalates links via
/// relatedCorruptionCaseId — no double entry.
model OfficialLegalCase {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officialId             String    @map("official_id") @db.Uuid
  title                  String    @db.VarChar(300)
  caseType               String    @map("case_type") @db.VarChar(30)
  status                 String    @db.VarChar(30)
  forum                  String?   @db.VarChar(150)
  caseNumber             String?   @map("case_number") @db.VarChar(100)
  filedDate              DateTime? @map("filed_date") @db.Date
  resolvedDate           DateTime? @map("resolved_date") @db.Date
  outcome                String?   @db.Text
  /// Official's role in the matter: defendant|plaintiff|claimant|respondent|named_in. Null = unknown.
  role                   String?   @db.VarChar(20)
  /// Plan 58 §3.8 record kind: adjudicated|allegation|listing|appearance. Null = legacy/unclassified.
  recordKind             String?   @map("record_kind") @db.VarChar(20)
  relatedCorruptionCaseId String?  @map("related_corruption_case_id") @db.Uuid
  confidence             String    @default("medium") @db.VarChar(10)
  sourceType             String    @default("manual") @map("source_type") @db.VarChar(20)
  reviewStatus           String    @default("unreviewed") @map("review_status") @db.VarChar(20)
  reviewedBy             String?   @map("reviewed_by") @db.VarChar(100)
  lastVerifiedAt         DateTime? @map("last_verified_at") @db.Timestamptz()
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  official              NigerianOfficial @relation(fields: [officialId], references: [id], onDelete: Cascade)
  relatedCorruptionCase CorruptionCase?  @relation(fields: [relatedCorruptionCaseId], references: [id])

  @@index([officialId], map: "idx_legal_cases_official")
  @@map("official_legal_cases")
}
