/// Elections contested + outcome. Scope arcs all nullable, NO exclusive CHECK
/// (presidential elections are national — no scope). A win can link to the
/// OfficialPosition it produced.
model OfficialElection {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officialId            String    @map("official_id") @db.Uuid
  electionType          String    @map("election_type") @db.VarChar(30)
  isPrimary             Boolean   @default(false) @map("is_primary")
  year                  Int
  electionDate          DateTime? @map("election_date") @db.Date
  partyAcronym          String?   @map("party_acronym") @db.VarChar(20)
  stateCode             String?   @map("state_code") @db.VarChar(30)
  constituencyCode      String?   @map("constituency_code") @db.VarChar(80)
  lgaCode               String?   @map("lga_code") @db.VarChar(60)
  wardCode              String?   @map("ward_code") @db.VarChar(100)
  result                String    @db.VarChar(20)
  votes                 Int?
  votePercentage        Decimal?  @map("vote_percentage") @db.Decimal(5, 2)
  winnerName            String?   @map("winner_name") @db.VarChar(200)
  resultedInPositionId  String?   @map("resulted_in_position_id") @db.Uuid
  notes                 String?   @db.Text
  confidence            String    @default("medium") @db.VarChar(10)
  sourceType            String    @default("manual") @map("source_type") @db.VarChar(20)
  reviewStatus          String    @default("unreviewed") @map("review_status") @db.VarChar(20)
  reviewedBy            String?   @map("reviewed_by") @db.VarChar(100)
  lastVerifiedAt        DateTime? @map("last_verified_at") @db.Timestamptz()
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  official           NigerianOfficial      @relation(fields: [officialId], references: [id], onDelete: Cascade)
  party              PoliticalParty?       @relation(fields: [partyAcronym], references: [acronym])
  state              NigerianState?        @relation(fields: [stateCode], references: [code])
  constituency       NigerianConstituency? @relation(fields: [constituencyCode], references: [code])
  lga                NigerianLga?          @relation(fields: [lgaCode], references: [code])
  ward               NigerianWard?         @relation(fields: [wardCode], references: [code])
  resultedInPosition OfficialPosition?     @relation(fields: [resultedInPositionId], references: [id])

  @@index([officialId], map: "idx_elections_official")
  @@index([electionType, year], map: "idx_elections_type_year")
  @@map("official_elections")
}


