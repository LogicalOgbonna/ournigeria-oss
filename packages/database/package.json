{
  "name": "@ournigeria/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --path /api -- prisma migrate deploy",
    "prisma:migrate:create": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --path /api -- npx tsx scripts/create-migration.ts",
    "prisma:studio": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --path /api -- prisma studio",
    "seed:party-chapters": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --path /api -- npx tsx scripts/seed-party-chapters.ts",
    "seed:party-profiles": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --path /api -- npx tsx scripts/seed-party-profiles.ts",
    "seed:party-officers": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --path /api -- npx tsx scripts/seed-party-officers.ts",
    "seed:party-candidates": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --path /api -- npx tsx scripts/seed-party-candidates.ts",
    "seed:governor-defections": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --path /api -- npx tsx scripts/seed-governor-defections.ts",
    "seed:ndc-defectors": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --path /api -- npx tsx scripts/seed-ndc-defectors.ts",
    "seed:campaigns": "infisical run --projectId ${INFISICAL_PROJECT_ID:-INFISICAL_PROJECT_ID} --path /api -- npx tsx scripts/seed-campaigns.ts",
    "reconcile:wards": "cd scripts && python3 -m reconcile_wards.cli"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@nestjs/common": "catalog:",
    "pg": "catalog:",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "prisma": "catalog:",
    "typescript": "catalog:",
    "@types/pg": "catalog:",
    "vitest": "catalog:"
  }
}
