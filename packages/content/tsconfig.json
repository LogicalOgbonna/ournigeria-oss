{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true
  },
  "include": ["*.ts", "templates/*.ts", "prompts/*.ts", "recipes/*.ts", "formats/*.ts", "lib/*.ts", "__tests__/*.ts"],
  "exclude": ["node_modules", "dist", "output"]
}
