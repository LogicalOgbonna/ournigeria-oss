{
  "name": "@ournigeria/content",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "main": "image-service.ts",
  "exports": {
    ".": "./image-service.ts",
    "./templates": "./templates/index.ts"
  },
  "scripts": {
    "generate": "infisical run --env dev -- npx tsx generate.ts",
    "query": "infisical run --env dev -- npx tsx query.ts",
    "render": "npx tsx render.ts",
    "engine": "infisical run --env dev -- npx tsx engine.ts",
    "batch": "infisical run --env dev -- npx tsx batch.ts",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@resvg/resvg-js": "2.6.2",
    "openai": "4.104.0",
    "pg": "8.18.0"
  },
  "devDependencies": {
    "@types/pg": "8.16.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
